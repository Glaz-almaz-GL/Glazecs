<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка для Windows без установки .NET и Windows App Runtime, из которой собирается установщик:
    bin\Publish\Portable-win-x64\
      Glazecs.exe   — лаунчер (Glazecs.App.Launcher), запускает app\Glazecs.exe
      app\          — приложение с нужными dll, без лишнего: переводов WinUI на неподдерживаемые языки,
                      .pdb, сжатых копий веб-файлов
  dotnet publish Glazecs.App.Desktop -f net10.0-windows10.0.19041.0 -p:PublishProfile=Portable-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PortableRootDir>$(MSBuildProjectDirectory)\bin\Publish\Portable-win-x64\</PortableRootDir>
    <PublishDir>$(PortableRootDir)app\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>

  <!-- Только для Windows: restore проходит по всем TargetFrameworks проекта, и win-x64 сломал бы Android/iOS -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Без .pdb: своего проекта и модулей -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.pri</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    Файлы, которые попадают в публикацию, но этой сборке не нужны. Их кладут пакеты и шаблоны мимо списка
    публикации, поэтому убираем их из готовой папки:
    - сжатые копии веб-файлов (.br/.gz) и карты .map — для веб-сервера, а WebView читает файлы с диска;
    - нативные библиотеки Whisper для чужих платформ (Linux, macOS, ARM, x86) и шейдер Metal для Apple;
    - картинки плиток и логотипов — только для упакованного (MSIX) приложения, окну хватает glazecs.ico;
    - .winmd — метаданные WinRT для компиляции, C#-приложение при запуске их не читает;
    - AboutAssets.txt — заготовка шаблона MAUI.
  -->
  <Target Name="RemoveUnusedPublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <_UnusedPublishFile Include="$(PublishDir)wwwroot\**\*.br;$(PublishDir)wwwroot\**\*.gz;$(PublishDir)wwwroot\**\*.map" />
      <_UnusedPublishFile Include="$(PublishDir)*.metal" />
      <_UnusedPublishFile Include="$(PublishDir)$(AssemblyName)*.png;$(PublishDir)WindowsAppRuntime.png" />
      <_UnusedPublishFile Include="$(PublishDir)*.winmd" />
      <_UnusedPublishFile Include="$(PublishDir)AboutAssets.txt" />
      <_UnusedRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes'))"
                         Condition="Exists('$(PublishDir)runtimes')" />
      <_UnusedRuntimeDir Remove="@(_UnusedRuntimeDir)" Condition="'%(Filename)' == '$(RuntimeIdentifier)' or '%(Filename)' == 'win'" />
    </ItemGroup>
    <Delete Files="@(_UnusedPublishFile)" />
    <RemoveDir Directories="@(_UnusedRuntimeDir)" />
  </Target>

  <!-- Лаунчер — в корень, рядом с папкой app -->
  <Target Name="PublishLauncher" AfterTargets="Publish">
    <PropertyGroup>
      <_LauncherProject>$(MSBuildProjectDirectory)\..\Glazecs.App.Launcher\Glazecs.App.Launcher.csproj</_LauncherProject>
      <!-- Глобальные свойства этой публикации (из командной строки dotnet publish) лаунчеру чужие -->
      <_LauncherForeignProperties>TargetFramework;RuntimeIdentifier;PublishProfile;SelfContained;Platform</_LauncherForeignProperties>
    </PropertyGroup>
    <!-- Restore — отдельным вызовом с другими свойствами: MSBuild не должен переиспользовать оценку проекта до restore -->
    <MSBuild Projects="$(_LauncherProject)" Targets="Restore" Properties="Configuration=Release;_LauncherRestore=true" RemoveProperties="$(_LauncherForeignProperties)" />
    <MSBuild Projects="$(_LauncherProject)" Targets="Publish" Properties="Configuration=Release;PublishDir=$(PortableRootDir)" RemoveProperties="$(_LauncherForeignProperties)" />
  </Target>
</Project>
